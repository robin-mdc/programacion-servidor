{
    "configurations": [
        {
            "type": "java",
            "name": "Spring Boot-CrudapiApplication<crudapi>",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "mainClass": "com.daw.crudapi.CrudapiApplication",
            "projectName": "crudapi",
            "args": "",
            // antes: "${workspaceFolder}/.env" (fichero que no existía)
            // motivo: el .env con las credenciales está dentro de crudapi
            "envFile": "${workspaceFolder}/crudapi/.env"
        }
    ]
}